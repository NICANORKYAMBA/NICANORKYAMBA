#!/usr/bin/python3
"""DarkMint screensaver: green matrix rain with a large clock and date.

Under xfce4-screensaver it draws into the window named by $XSCREENSAVER_WINDOW.
Run it directly for a preview window:  darkmint-screensaver [--window WxH]
"""
import os
import random
import sys
import time
import tkinter as tk

BG = "#050806"
TRAIL = 16                      # glyphs per falling column
CELL_W, CELL_H = 18, 22
FPS = 24
GLYPHS = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:=*+<>"
FONT = "JetBrainsMono Nerd Font"
DRAGON = os.path.expanduser("~/.local/share/darkmint-screensaver/dragon.png")


def trail_colour(i):
    """Head (i=0) is near-white mint, fading to dark green down the trail."""
    if i == 0:
        return "#e6fff0"
    t = i / (TRAIL - 1)
    r = int(0x5d + (0x0b - 0x5d) * t)
    g = int(0xff + (0x3a - 0xff) * t)
    b = int(0xa8 + (0x1c - 0xa8) * t)
    return f"#{r:02x}{g:02x}{b:02x}"


class Saver:
    def __init__(self, root):
        self.root = root
        root.update_idletasks()
        self.w = max(root.winfo_width(), 320)
        self.h = max(root.winfo_height(), 240)
        self.c = tk.Canvas(root, bg=BG, highlightthickness=0, width=self.w, height=self.h)
        self.c.pack(fill="both", expand=True)
        self.font = (FONT, 13)
        self.columns = []
        for col in range(self.w // CELL_W + 1):
            self.columns.append(self._new_column(col * CELL_W + CELL_W // 2, first=True))
        self._build_overlay()
        self.frame = 0
        self.tick()

    def _new_column(self, x, first=False):
        tag = f"col{x}"
        top = random.randint(-self.h, 0) if first else -TRAIL * CELL_H - random.randint(0, self.h // 2)
        items = []
        for i in range(TRAIL):
            # i=0 is the head, at the bottom of the trail
            items.append(self.c.create_text(x, top - i * CELL_H, text=random.choice(GLYPHS),
                                            fill=trail_colour(i), font=self.font, tags=tag))
        return {"tag": tag, "x": x, "items": items, "y": top,
                "every": random.choice((1, 1, 2, 2, 3)), "lower": True}

    def _build_overlay(self):
        cx, cy = self.w // 2, self.h // 2
        big = max(48, min(self.w // 9, 170))
        pw, ph = int(big * 3.6), int(big * 2.1)
        # Stippled panel lets the rain show through, like frosted glass
        self.c.create_rectangle(cx - pw // 2, cy - ph // 2, cx + pw // 2, cy + ph // 2,
                                fill=BG, stipple="gray75", outline="#1f3324", tags="overlay")
        self.c.create_line(cx - pw // 2, cy - ph // 2, cx - pw // 2 + 120, cy - ph // 2,
                           fill="#39d98a", width=3, tags="overlay")
        self.dragon = None
        if os.path.exists(DRAGON):
            try:
                self.dragon = tk.PhotoImage(file=DRAGON)
                self.c.create_image(cx, cy - ph // 2 - self.dragon.height() // 2 - 10,
                                    image=self.dragon, tags="overlay")
            except tk.TclError:
                self.dragon = None
        self.clock = self.c.create_text(cx, cy - big * 0.15, text="", fill="#5dffa8",
                                        font=(FONT, big, "bold"), tags="overlay")
        self.date = self.c.create_text(cx, cy + big * 0.62, text="", fill="#8fa894",
                                       font=(FONT, max(14, big // 6)), tags="overlay")
        self.c.tag_raise("overlay")

    def tick(self):
        self.frame += 1
        for col in self.columns:
            if self.frame % col["every"]:
                continue
            self.c.move(col["tag"], 0, CELL_H)
            col["y"] += CELL_H
            # The head picks up a new glyph as it falls; occasionally the trail flickers too
            self.c.itemconfigure(col["items"][0], text=random.choice(GLYPHS))
            if random.random() < 0.15:
                self.c.itemconfigure(random.choice(col["items"][1:]), text=random.choice(GLYPHS))
            if col["y"] - TRAIL * CELL_H > self.h:
                shift = -(col["y"] + random.randint(0, self.h // 2))
                self.c.move(col["tag"], 0, shift)
                col["y"] += shift
                col["every"] = random.choice((1, 1, 2, 2, 3))
        if self.frame % (FPS // 2) == 0 or self.frame == 1:
            now = time.localtime()
            colon = ":" if now.tm_sec % 2 == 0 else " "
            self.c.itemconfigure(self.clock, text=time.strftime(f"%H{colon}%M", now))
            self.c.itemconfigure(self.date, text=time.strftime("%A · %d %B %Y", now))
        self.c.tag_raise("overlay")
        self.root.after(1000 // FPS, self.tick)


def main():
    wid = os.environ.get("XSCREENSAVER_WINDOW")
    if wid:
        # The screensaver discards our stderr; keep errors somewhere readable
        log = os.path.expanduser("~/.cache/darkmint-screensaver.log")
        sys.stderr = open(log, "a", buffering=1)
        print(f"{time.ctime()} start window={wid} argv={sys.argv[1:]}", file=sys.stderr)
        root = tk.Tk(use=str(int(wid, 0)))
    else:
        root = tk.Tk()
        root.title("DarkMint screensaver preview")
        geo = "1280x720"
        if "--window" in sys.argv:
            geo = sys.argv[sys.argv.index("--window") + 1]
        root.geometry(geo)
        root.update()
    root.configure(bg=BG)
    root.config(cursor="none")
    Saver(root)
    root.mainloop()


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# One-time (needs sudo): make the LightDM login screen match the DarkMint desktop.
#   darkmint-login-setup          install the DarkMint-Login theme and greeter config
#   darkmint-login-setup --undo   go back to the login screen as it was before the DarkMint-Login theme
set -euo pipefail
G=/etc/lightdm/lightdm-gtk-greeter.conf
SRC=~/.local/share/darkmint-login
W=/usr/share/backgrounds/darkmint/darkmint-kali-net.jpg

if [ "${1:-}" = --undo ]; then
  B="$G.bak-before-login-theme"; [ -f "$B" ] || B="$G.bak-darkmint"
  sudo cp "$B" "$G"
  sudo rm -rf /usr/share/themes/DarkMint-Login
  echo "Login screen restored from $B"
  exit 0
fi

sudo install -Dm644 "$HOME/Pictures/wallpapers/darkmint-kali-net.jpg" "$W"   # greeter user can't read $HOME
sudo cp -n "$G" "$G.bak-darkmint"                 # Kali's original, from the first run
sudo cp -n "$G" "$G.bak-before-login-theme"       # the config just before the DarkMint-Login theme
# The greeter runs as the lightdm user: avatar and fonts must live in system folders
sudo install -Dm644 "$HOME/.face" /usr/share/backgrounds/darkmint/avatar.png
sudo install -Dm644 -t /usr/local/share/fonts/JetBrainsMono "$HOME"/.local/share/fonts/JetBrainsMonoNerdFont-{Regular,Bold}.ttf
sudo fc-cache -f /usr/local/share/fonts >/dev/null
sudo rm -rf /usr/share/themes/DarkMint-Login
sudo cp -r "$SRC/DarkMint-Login" /usr/share/themes/DarkMint-Login
sudo chmod -R a+rX /usr/share/themes/DarkMint-Login
sudo install -m644 "$SRC/lightdm-gtk-greeter.conf" "$G"
grep -vE '^\s*(#|$)' "$G"

# The greeter can't read ~ (mode 700): give it the wallpaper and avatar through AccountsService
U="/org/freedesktop/Accounts/User$(id -u)"
busctl set-property org.freedesktop.Accounts "$U" \
  org.freedesktop.DisplayManager.AccountsService BackgroundFile s "$W" || true
[ -f ~/.face ] && busctl call org.freedesktop.Accounts "$U" org.freedesktop.Accounts.User SetIconFile s "$HOME/.face" || true

echo "Login screen updated. Original saved as $G.bak-darkmint (undo: darkmint-login-setup --undo)"

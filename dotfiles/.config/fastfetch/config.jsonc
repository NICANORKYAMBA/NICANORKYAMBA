// DarkMint Neon system card — run `ff`
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "kali",
        "color": { "1": "38;2;57;217;138", "2": "38;2;93;255;168" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;57;217;138", "title": "38;2;93;255;168" },
        "key": { "width": 12 }
    },
    "modules": [
        "title",
        { "type": "custom", "format": "\u001b[38;2;31;51;36m──────────────────────────────────────" },
        { "type": "os",       "key": "os" },
        { "type": "host",     "key": "host", "format": "{name}" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "packages" },
        { "type": "shell",    "key": "shell" },
        { "type": "wm",       "key": "wm" },
        { "type": "theme",    "key": "theme" },
        { "type": "icons",    "key": "icons" },
        { "type": "terminal", "key": "terminal" },
        { "type": "custom", "format": "\u001b[38;2;31;51;36m──────────────────────────────────────" },
        { "type": "cpu",      "key": "cpu" },
        { "type": "gpu",      "key": "gpu" },
        { "type": "memory",   "key": "memory" },
        { "type": "disk",     "key": "disk", "folders": "/" },
        { "type": "battery",  "key": "battery" },
        { "type": "localip",  "key": "local ip" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
